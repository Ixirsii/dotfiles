#!/bin/bash

# sysinfo_page - Print git status on each package in a Brazil workspace

# ################################ VARIABLES ################################# #

# Console colors
default="\e[0m"
red="\e[31m"

# src directory
src="src"

# ################################ FUNCTIONS ################################# #

is_src_dir () {
    dir=$(echo $1 | awk -F / '{print $(NF-1)}')

    [[ "$dir" = "$src" ]]
    return
}

search_up_path () {
    path="/"

    for dir in $(pwd | sed -e 's/\// /g'); do
        path="$path$dir/"

        if [ $dir = $1 ]; then
            break
        fi
    done

    echo $path
}

search_down_path () {
    echo "$(pwd)/src/"
}

# ################################# PROGRAM ################################## #

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <option>"
    echo "Options:"
    echo -e "\tIf none of the following options are supplied every argument"
    echo -e "\tgets evaluated as a single command in every package directory"
    echo ""
    echo -e "\t-a, --build-apollo\tRun \`brazil-build apollo-pkg\` on every package"
    echo -e "\t-b, --build\t\tRun \`brazil-build\` on every package"
    echo -e "\t-r, --build-release\tRun \`brazil-build\` release on every package"
    echo -e "\t-s, --status\t\tRun \`git status\` on every package"

    exit 1;
fi

# Check if the current directory is in a Brazil workspace
brazil ws show > /dev/null 2>&1
if [ $? -eq 1 ]; then
    >&2 echo -e "$red\tNot inside a Brazil workspace, exiting$default"
    exit 1
fi

src_dir=$(search_up_path $src)

is_src_dir $src_dir
if [[ $? -eq 1 ]]; then
    src_dir=$(search_down_path $src)

    is_src_dir $src_dir
    if [[ $? -eq 1 ]]; then
        >&2 echo -e "$red\tCould not find src directory in workspace"
        exit 1
    fi
fi

cd "$src_dir"
cmd=""

case $1 in
    -s|--status)
        cmd="git status"
        ;;
    -b|--build)
        cmd="brazil-build"
        ;;
    -a|--build-apollo)
        cmd="brazil-build apollo-pkg"
        ;;
    -r|--build-release)
        cmd="brazil-build release"
        ;;
    --default)
        cmd="$@"
        ;;
esac

for dir in $(ls); do
    pushd $dir > /dev/null

    echo $dir;
    eval $cmd
    echo -e "\n"

    popd > /dev/null
done
