#!/bin/bash

jar_path="/usr/lib/minecraft/"
jar="Minecraft.jar"
opts=""

function print_help() {
        echo "Usage: minecraft [java-options] [minecraft|magic]"
        exit
}

function parse_args() {
    echo "arguments: $@"
    for arg in "$@"; do
        echo "$arg"
        case "$arg" in
            -h)         print_help ;;
            magic)      jar="MagicLauncher_1.2.5.jar" ;;
            minecraft)  jar="Minecraft.jar" ;;
            *)          opts="$opts" + "$arg" ;;
        esac
    done
}

parse_args "$@"
jar_path="$jar_path$jar"
echo "Lanuching minecraft in $jar_path"
java -jar "$jar_path"
