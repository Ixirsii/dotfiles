language = en
font-family = "SauceCodePro NFM"
font-size = 14
theme = "Catppuccin Mocha"
background-opacity = 0.8
background-blur = true
cursor-style = block
mouse-hide-while-typing = true
unfocused-split-opacity = 1.0
window-padding-x = 0
window-padding-y = 0
clipboard-read = ask
clipboard-write = allow
confirm-close-surface = true
quit-after-last-window-closed = true
macos-window-buttons = visible
macos-titlebar-style = transparent

keybind = super+shift+backslash=new_split:right
keybind = super+alt+shift+backslash=new_split:left
keybind = super+shift+-=new_split:down
keybind = super+alt+shift+-=new_split:up
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right
