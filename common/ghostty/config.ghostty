language = en
font-family = "SauceCodePro NFM"
font-family = "Noto Sans Mono"
font-family = "Noto Sans Mono CJK JP"
font-family = "Noto Sans Mono CJK KR"
font-family = "Noto Sans Mono CJK SC"
font-family = "Noto Sans Mono CJK TC"
font-family = "Noto Sans Mono CJK HK"
font-size = 14
theme = "Catppuccin Mocha"
background-opacity = 0.5
background-blur = true
cursor-style = block
mouse-hide-while-typing = true
unfocused-split-opacity = 1.0
window-padding-x = 0
window-padding-y = 0
clipboard-read = ask
clipboard-write = allow
confirm-close-surface = false
quit-after-last-window-closed = true
macos-window-buttons = visible
macos-titlebar-style = transparent
config-file = keybinds.ghostty

keybind = super+shift+backslash=new_split:right
keybind = super+alt+shift+backslash=new_split:left
keybind = super+shift+-=new_split:down
keybind = super+alt+shift+-=new_split:up
