[include]
	path = ~/.config/delta/catppuccin.gitconfig

[user]
    email = ixirsii@9dev.tech
    name = Ryan Porterfield
    signingKey = D299B6482C961930F6EAAB2D9D923B929C317D97

[alias]
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)"%an" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order

[coderabbit]
	machineId = cli/f0997d7e7f254f6fa33c1a9bc4982146

[color]
    ui = auto

[commit]
    gpgSign = true

[core]
    autocrlf = input
    pager = delta

[delta]
    features = catppuccin-mocha
    navigate = true
    side-by-side = true

[diff]
    colorMoved = default

[gpg]
    program = gpg

[fetch]
    prune = true

[http]
    sslVerify = true

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictstyle = zdiff3

[push]
    default = simple

[pull]
    ff = only

[rebase]
    autoStash = true

[rerere]
    enabled = true

[tag]
    forceSignAnnotated = true

[include]
	path = ~/.config/git/os.gitconfig
