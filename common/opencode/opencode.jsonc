{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.2-astra",
  "agents": {
    "explore": {
      "model": "openai/gpt-6-luna#low",
    },
    "general": {
      "model": "openai/gpt-6.2-sol#medium",
    },
    "title": {
      "model": "openai/gpt-6-luna#none",
    },
    "summary": {
      "model": "openai/gpt-6-luna#low",
    },
  },
  "default_agent": "plan",
  "shell": "/bin/zsh",
  "formatter": true,
  "permissions": [
    // Spotify's OAuth grant includes writes; expose only playlist reads.
    { "action": "spotify_*", "resource": "*", "effect": "deny" },
    { "action": "spotify_list_playlists", "resource": "*", "effect": "allow" },
    { "action": "spotify_get_playlist", "resource": "*", "effect": "allow" },
    { "action": "spotify_get_playlist_tracks", "resource": "*", "effect": "allow" },
    // Plex enables writes as a group; only permit playlist creation, with approval.
    { "action": "plex_*", "resource": "*", "effect": "deny" },
    { "action": "plex_get_libraries", "resource": "*", "effect": "allow" },
    { "action": "plex_get_library_items", "resource": "*", "effect": "allow" },
    { "action": "plex_search_media", "resource": "*", "effect": "allow" },
    { "action": "plex_get_media_details", "resource": "*", "effect": "allow" },
    { "action": "plex_get_playlists", "resource": "*", "effect": "allow" },
    { "action": "plex_get_playlist_items", "resource": "*", "effect": "allow" },
    { "action": "plex_create_playlist", "resource": "*", "effect": "ask" },
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--headless",
          "--no-usage-statistics",
        ],
        "disabled": false,
        "type": "local",
      },
      "cloudflare": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
      },
      "cloudflare-docs": {
        "disabled": true,
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
      },
      "firefox-devtools": {
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--headless",
          "--firefox-path",
          "/Applications/Firefox.app/Contents/MacOS/firefox",
        ],
        "disabled": false,
        "type": "local",
      },
      "github": {
        "command": ["github-mcp-server", "stdio"],
        "disabled": false,
        "type": "local",
      },
      "linear": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "plex": {
        "type": "local",
        "command": ["npx", "-y", "plex-mcp-server@1.9.2", "--transport", "stdio"],
        "disabled": true,
        "environment": {
          "PLEX_URL": "{file:~/.config/opencode-media/plex-url}",
          "PLEX_TOKEN": "{file:~/.config/opencode-media/plex-token}",
          "PLEX_ENABLE_MUTATIVE_OPS": "true",
        },
      },
      "porkbun": {
        "command": [
          "/bin/sh",
          "-c",
          "exec op run --no-masking --env-file=\"$HOME/.config/op-env/opencode.env\" -- npx -y @porkbunllc/mcp-server@0.12.0",
        ],
        "disabled": true,
        "type": "local",
      },
      "railway": {
        "command": ["railway", "mcp"],
        "disabled": true,
        "type": "local",
      },
      "safari-mcp-stp": {
        "command": [
          "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver",
          "--mcp",
        ],
        "disabled": false,
        "type": "local",
      },
      "semgrep": {
        "command": ["semgrep", "mcp"],
        "disabled": true,
        "type": "local",
      },
      "spotify": {
        "type": "local",
        "command": ["uvx", "--python", "3.12", "spotify-mcp-jamiew@0.9.2"],
        "disabled": true,
        // Spotipy stores its OAuth token cache in the working directory.
        "cwd": "{env:HOME}/.config/opencode-media",
        "environment": {
          "SPOTIFY_CLIENT_ID": "{file:~/.config/opencode-media/spotify-client-id}",
          "SPOTIFY_CLIENT_SECRET": "{file:~/.config/opencode-media/spotify-client-secret}",
          "SPOTIFY_REDIRECT_URI": "http://127.0.0.1:8888",
        },
      },
      "docker": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/uvx",
          "--python",
          "3.14",
          "docker-mcp-server",
        ],
        "environment": {
          "DOCKER_HOST": "unix:///Users/ryan/.orbstack/run/docker.sock",
        },
      },
    },
  },
}
