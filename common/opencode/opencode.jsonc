{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.6-sol",
    "small_model": "openai/gpt-5.6-luna",
    "lsp": true,
    "default_agent": "plan",
    "shell": "/bin/zsh",
    "formatter": true,
    "mcp": {
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--no-usage-statistics"
            ],
            "enabled": true
        },
        "cloudflare": {
            "type": "remote",
            "url": "https://mcp.cloudflare.com/mcp",
            "enabled": true
        },
        "cloudflare-docs": {
            "type": "remote",
            "url": "https://docs.mcp.cloudflare.com/mcp",
            "enabled": true
        },
        "firefox-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@mozilla/firefox-devtools-mcp@latest",
                "--firefox-path",
                "/Applications/Firefox.app/Contents/MacOS/firefox"
            ],
            "enabled": true
        },
        "linear": {
            "type": "remote",
            "url": "https://mcp.linear.app/mcp",
            "enabled": true
        },
        "porkbun": {
            "type": "local",
            "command": [
                "/bin/sh",
                "-c",
                "exec op run --no-masking --env-file=\"$HOME/.config/op-env/opencode.env\" -- npx -y @porkbunllc/mcp-server@0.12.0"
            ],
            "enabled": true
        },
        "railway": {
            "command": [
                "railway",
                "mcp"
            ],
            "enabled": true,
            "type": "local"
        },
        "safari-mcp-stp": {
            "type": "local",
            "command": [
                "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver",
                "--mcp"
            ],
            "enabled": true
        }
    }
}
