{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna",
    },
  },
  "default_agent": "plan",
  "shell": "/bin/zsh",
  "formatter": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--headless",
          "--no-usage-statistics",
        ],
        "disabled": false,
        "type": "local",
      },
      "cloudflare": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
      },
      "cloudflare-docs": {
        "disabled": true,
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
      },
      "firefox-devtools": {
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--firefox-path",
          "/Applications/Firefox.app/Contents/MacOS/firefox",
        ],
        "disabled": false,
        "type": "local",
      },
      "github": {
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}",
        },
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
      },
      "linear": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "porkbun": {
        "command": [
          "/bin/sh",
          "-c",
          "exec op run --no-masking --env-file=\"$HOME/.config/op-env/opencode.env\" -- npx -y @porkbunllc/mcp-server@0.12.0",
        ],
        "disabled": true,
        "type": "local",
      },
      "railway": {
        "command": ["railway", "mcp"],
        "disabled": true,
        "type": "local",
      },
      "safari-mcp-stp": {
        "command": [
          "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver",
          "--mcp",
        ],
        "disabled": false,
        "type": "local",
      },
      "semgrep": {
        "command": ["semgrep", "mcp"],
        "disabled": true,
        "type": "local",
      },
    },
  },
}
