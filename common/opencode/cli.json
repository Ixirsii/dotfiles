{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "command.palette.show": "ctrl+shift+p",
    "dialog.select.prev": "up",
    "prompt.autocomplete.prev": "up",
    "prompt.editor": false,
    "variant.list": "<leader>e"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "grouping": "auto"
  },
  "animations": true
}
