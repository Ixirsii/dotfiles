 void
+attachaside(Client *c) {
+	if(c->mon->sel == NULL || c->mon->sel == c->mon->cl->clients || c->mon->sel->isfloating) {
+		attach(c);
+		return;
+	}
+    Client *at;
+    for(at = c->mon->cl->clients; at->next != c->mon->sel; at = at->next);
+	c->next = at->next;
+	at->next = c;
+}
