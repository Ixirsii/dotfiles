{
    "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi-for-mac/refs/heads/master/schema.json",
    "app_specific_configuration_path": "$HOME/.config/komorebi/applications.json",
    "cross_monitor_move_behaviour": "Insert",
    "default_workspace_padding": 12,
    "default_container_padding": 12,
    "border": true,
    "border_width": 2,
    "border_offset": -5,
    "border_radius": 18,
    "floating_window_aspect_ratio": "Widescreen",
    "floating_layer_behaviour": "Float",
    "resize_delta": 100,
    "ignore_rules": [],
    "floating_applications": [],
    "manage_rules": [],
    "theme": {
        "bar_accent": "Sky",
        "floating_border": "Yellow",
        "monocle_border": "Pink",
        "name": "Mocha",
        "palette": "Catppuccin",
        "single_border": "Sky",
        "stack_border": "Green",
        "unfocused_border": "Overlay0",
        "unfocused_locked_border": "Red"
    },
    "monitors": [
        {
            "workspaces": [
                {
                    "name": "",
                    "layout": "BSP",
                    "initial_workspace_rules": []
                },
                {
                    "name": "󰖟",
                    "layout": "Grid"
                },
                {
                    "name": "",
                    "layout": "Scrolling"
                },
                {
                    "name": "",
                    "layout": "Grid"
                },
                {
                    "name": "󰁤",
                    "layout": "BSP"
                },
                {
                    "name": "",
                    "layout": "BSP"
                },
                {
                    "name": "",
                    "layout": "BSP"
                },
                {
                    "name": "",
                    "layout": "Grid"
                },
                {
                    "name": "󰻞",
                    "layout": "Scrolling"
                }
            ]
        }
    ]
}
