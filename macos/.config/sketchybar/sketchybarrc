#!/usr/bin/env bash

# Colorscheme
source $CONFIG_DIR/colors.sh

FUNCTION_DIR=$CONFIG_DIR/functions
PLUGIN_DIR=$CONFIG_DIR/plugins
ITEM_DIR=$CONFIG_DIR/items
ICON_FONT="sketchybar-app-font:Regular:16"
LABEL_FONT="SF Pro:Semibold:16"

sketchybar --bar position=top height=40 blur_radius=30 color=$BAR_COLOR

default=(
    background.color=$BACKGROUND_COLOR
    background.corner_radius=8
    background.drawing=off
    background.height=40
    background.padding_left=4
    background.padding_right=4
    icon.color=$TEXT_COLOR
    icon.font="$ICON_FONT"
    icon.padding_left=4
    icon.padding_right=4
    label.color=$TEXT_COLOR
    label.font="$LABEL_FONT"
    label.padding_left=8
    label.padding_right=8
)

sketchybar --default "${default[@]}"

# Add the aerospace events we specified in aerospace.toml
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_monitor_change

# Left side items
source $ITEM_DIR/apple.sh
source $ITEM_DIR/spaces.sh
source $ITEM_DIR/space_separator.sh
source $ITEM_DIR/front_app.sh

# Center items
source $ITEM_DIR/media.sh

# Right side items
source $ITEM_DIR/calendar.sh
source $ITEM_DIR/volume.sh
source $ITEM_DIR/battery.sh
source $ITEM_DIR/cpu.sh

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
