#!/usr/bin/env sh

# Keep SIP enabled; this configuration does not use the scripting addition.
yabai -m config \
    external_bar all:40:0 \
    menubar_opacity 1.0 \
    mouse_follows_focus off \
    focus_follows_mouse autofocus \
    display_arrangement_order default \
    window_origin_display default \
    window_placement second_child \
    window_insertion_point focused \
    window_zoom_persist on \
    skip_window_focus_animation on \
    insert_feedback_color 0xff89dceb \
    split_ratio 0.50 \
    split_type auto \
    auto_balance off \
    top_padding 20 \
    bottom_padding 20 \
    left_padding 20 \
    right_padding 20 \
    window_gap 5 \
    layout bsp \
    mouse_modifier fn \
    mouse_action1 move \
    mouse_action2 resize \
    mouse_drop_action swap

# Disable automatic Space reordering in System Settings so these indexes remain stable.
yabai -m rule --add label=terminal-space app='^(Ghostty|WezTerm)$' space=1
yabai -m rule --add label=browser-space app='^(Zen|Firefox|Google Chrome|Safari|Safari Technology Preview)$' space=2
yabai -m rule --add label=development-space app='^(IntelliJ IDEA|OrbStack|Postman)$' space=3
yabai -m rule --add label=project-space app='^(Sublime Text|Obsidian|Linear)$' space=4
yabai -m rule --add label=creative-space app='^(GIMP|Inkscape|SvgConverter)$' space=5
yabai -m rule --add label=media-space app='^(NetNewsWire|Plex|Spotify)$' space=6
yabai -m rule --add label=communication-space app='^(Signal|Legcord|Discord|zoom\.us)$' space=7
yabai -m rule --add label=email-space app='^Fastmail$' space=8
yabai -m rule --add label=security-space app='^(1Password|Proton Pass|Ente Auth|Yubico Authenticator|Tailscale)$' space=9

# macOS exposes native Ghostty tabs as windows, so rebuild the tree after tab changes.
yabai -m signal --add app='^Ghostty$' event=window_created action='yabai -m space --layout bsp'
yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --layout bsp'
