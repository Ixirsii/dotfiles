#!/bin/sh

set -u

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
debug="$script_dir/spaces-debug"

if [ ! -x "$debug" ]; then
    printf 'spaces-debug is not executable: %s\n' "$debug" >&2
    exit 1
fi

printf 'Capturing broken state...\n'
before=$($debug) || exit 1

printf 'Restarting Dock...\n'
killall Dock || exit 1

attempt=0
while ! pgrep -x Dock >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 20 ]; then
        printf 'Dock did not restart within 10 seconds.\n' >&2
        exit 1
    fi
    sleep 0.5
done

sleep 2
printf 'Restarting Yabai...\n'
yabai --restart-service || exit 1

attempt=0
while ! yabai -m query --spaces >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 20 ]; then
        printf 'Yabai did not become ready within 10 seconds.\n' >&2
        exit 1
    fi
    sleep 0.5
done

printf 'Capturing recovered state...\n'
after=$($debug) || exit 1

printf '\nBefore: %s\n' "$before"
printf 'After:  %s\n\n' "$after"
while IFS= read -r line; do
    case $line in
        'State agreement:'*) printf '%s\n' "$line" ;;
    esac
done <"$after/summary.txt"
