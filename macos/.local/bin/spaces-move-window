#!/bin/sh

set -u

if [ "$#" -ne 1 ]; then
    printf 'usage: spaces-move-window SPACE\n' >&2
    exit 2
fi

target=$1
yabai=${YABAI:-"$HOME/.local/bin/yabai"}
jq=${JQ:-/opt/homebrew/bin/jq}
window=$("$yabai" -m query --windows --window | "$jq" -r '.id') || exit 1
focus_follows_mouse=$("$yabai" -m config focus_follows_mouse) || exit 1

restore_focus_follows_mouse() {
    "$yabai" -m config focus_follows_mouse "$focus_follows_mouse"
}

trap restore_focus_follows_mouse 0 1 2 15
"$yabai" -m config focus_follows_mouse off || exit 1

"$yabai" -m window "$window" --space "$target" || exit 1
"$yabai" -m space --focus "$target" 2>/dev/null || true

attempt=0
while [ "$("$yabai" -m query --spaces --space | "$jq" -r '.index')" != "$target" ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 20 ]; then
        printf 'Space %s did not receive focus.\n' "$target" >&2
        exit 1
    fi
    sleep 0.05
done

sleep 0.5
"$yabai" -m window "$window" --focus
sleep 0.2

restore_focus_follows_mouse
trap - 0 1 2 15
