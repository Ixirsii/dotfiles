#!/bin/sh

set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(dirname -- "$script_dir")
manifest="$repo_dir/packages/neovim/commands.txt"
missing=0
go_bin=

version_at_least() {
    awk -v actual="$1" -v minimum="$2" 'BEGIN {
        split(actual, a, "."); split(minimum, b, ".");
        for (i = 1; i <= 3; i++) {
            if (a[i] + 0 > b[i] + 0) exit 0;
            if (a[i] + 0 < b[i] + 0) exit 1;
        }
        exit 0;
    }'
}

check_version() {
    tool=$1
    minimum=$2
    if output=$("$tool" --version 2>&1); then
        version=$(printf '%s\n' "$output" | sed -n '1s/^[^0-9]*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*$/\1/p')
        if [ -n "$version" ] && version_at_least "$version" "$minimum"; then
            printf '  ok       %-36s %s\n' "$tool" "$version"
            return
        fi
    fi
    printf '  invalid  %s (requires %s or newer)\n' "$tool" "$minimum"
    missing=1
}

if command -v go >/dev/null 2>&1; then
    go_bin=$(go env GOBIN)
    [ -n "$go_bin" ] || go_bin="$(go env GOPATH)/bin"
fi

printf 'System-level Neovim tools:\n'
while IFS= read -r tool || [ -n "$tool" ]; do
    case "$tool" in
        "" | \#*) continue ;;
    esac

    if path=$(command -v "$tool" 2>/dev/null); then
        printf '  ok       %-36s %s\n' "$tool" "$path"
    elif [ -n "$go_bin" ] && [ -x "$go_bin/$tool" ]; then
        printf '  path     %-36s %s (not on PATH)\n' "$tool" "$go_bin/$tool"
        missing=1
    elif [ -x "$HOME/.dotnet/tools/$tool" ]; then
        printf '  path     %-36s %s (not on PATH)\n' "$tool" "$HOME/.dotnet/tools/$tool"
        missing=1
    else
        printf '  missing  %s\n' "$tool"
        missing=1
    fi
done < "$manifest"

printf '\nRuntime and parser prerequisites:\n'
check_version nvim 0.12.0
check_version node 22.22.2
check_version tree-sitter 0.26.1
if dotnet --list-sdks 2>/dev/null | awk '
    /^[0-9]+\./ { split($1, version, "."); if (version[1] >= 10) found = 1 }
    END { exit !found }
'; then
    printf '  ok       .NET SDK (10 or newer installed)\n'
else
    printf '  missing  .NET SDK 10 or newer (required by Roslyn)\n'
    missing=1
fi
for tool in rust-analyzer rustfmt; do
    if "$tool" --version >/dev/null 2>&1; then
        printf '  ok       %s (runnable)\n' "$tool"
    else
        printf '  invalid  %s (check rustup components for the active toolchain)\n' "$tool"
        missing=1
    fi
done
for tool in tar curl; do
    if command -v "$tool" >/dev/null 2>&1; then
        printf '  ok       %s\n' "$tool"
    else
        printf '  missing  %s\n' "$tool"
        missing=1
    fi
done
compiler_found=false
for compiler in "${CC:-cc}" gcc clang; do
    if command -v "$compiler" >/dev/null 2>&1; then
        printf '  ok       C compiler (%s)\n' "$compiler"
        compiler_found=true
        break
    fi
done
if ! "$compiler_found"; then
    printf '  missing  C compiler\n'
    missing=1
fi

if command -v node >/dev/null 2>&1; then
    node <<'NODE' || missing=1
const fs = require("node:fs");
const path = require("node:path");
let directory = process.cwd();
while (!fs.existsSync(path.join(directory, "package.json"))) {
    const parent = path.dirname(directory);
    if (parent === directory) {
        console.log("\nProject-local JavaScript checks skipped (no ancestor package.json).");
        process.exit(0);
    }
    directory = parent;
}
console.log(`\nProject-local JavaScript tools (${directory}):`);
const manifest = JSON.parse(fs.readFileSync(path.join(directory, "package.json"), "utf8"));
const dependencies = {
    ...manifest.dependencies,
    ...manifest.devDependencies,
    ...manifest.optionalDependencies,
    ...manifest.peerDependencies,
};
for (const tool of ["eslint", "prettier", "typescript"]) {
    try {
        const resolved = require.resolve(`${tool}/package.json`, { paths: [directory] });
        console.log(`  ok       ${tool} (${resolved})`);
    } catch {
        if (Object.hasOwn(dependencies, tool)) {
            console.log(`  missing  ${tool} (declared in package.json; install project dependencies)`);
            process.exitCode = 1;
        } else {
            console.log(`  optional ${tool} (not installed or declared)`);
        }
    }
}
NODE
else
    printf '\nProject-local JavaScript checks unavailable (Node.js missing).\n'
fi

exit "$missing"
