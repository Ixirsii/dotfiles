# Phil!'s ZSH prompt

ZLE_RPROMPT_INDENT=0

# Parameter expansion
setopt prompt_subst
autoload -Uz vcs_info
autoload zsh/terminfo

# See if we can use extended characters to look nicer.
typeset -A altchar
set -A altchar ${(s..)terminfo[acsc]}
SET_CHARSET="%{$terminfo[enacs]%}"
SHIFT_IN="%{$terminfo[smacs]%}"
SHIFT_OUT="%{$terminfo[rmacs]%}"
HBAR=${altchar[q]:--}
ULCORNER=${altchar[l]:--}
LLCORNER=${altchar[m]:--}
LRCORNER=${altchar[j]:--}
URCORNER=${altchar[k]:--}

# Some magic for loading the current git branch
zstyle ':vcs_info:*' actionformats '%F{4} %b%F{6}|%F{9}%a%f'
zstyle ':vcs_info:*' formats '%F{4}%b%f'
zstyle ':vcs_info:(sv[nk]|bzr):*' branchformat '%b%F{1}:%F{3}%r'

function precmd {
    # Load VCS info
    vcs_info

    # Truncate the path if it's too long.
    FILLBAR=""
    PWDLEN=""
    VCS_INFO=""
    
    local promptsize=${#${(%):---(%n@%m)---()--}}
    local pwdsize=${#${(%):-%~}}

    if [[ "$promptsize + $pwdsize" -gt $COLUMNS ]]; then
        ((PWDLEN=$COLUMNS - $promptsize))
    else
        FILLBAR="\${(l.(($COLUMNS - ($promptsize + $pwdsize)))..${HBAR}.)}"
    fi
}

function setprompt () {
    # Decide if we need to set titlebar text.
    case $TERM in
	xterm*)
	    TITLEBAR=$'%{\e]0;%(!.-=*[ROOT]*=- | .)%n@%m:%~ | ${COLUMNS}x${LINES} | 
%y\a%}'
	    ;;
	screen)
	    TITLEBAR=$'%{\e_screen \005 (\005t) | %(!.-=[ROOT]=- | .)%n@%m:%~ | 
${COLUMNS}x${LINES} | %y\e\\%}'
	    ;;
	*)
	    TITLEBAR=''
	    ;;
    esac
    
    
    ###
    # Decide whether to set a screen title
    if [[ "$TERM" == "screen" ]]; then
	STITLE=$'%{\ekzsh\e\\%}'
    else
	STITLE=''
    fi
    
    
	## Define open and close braces as variables so zsh doesn't do weird things
    OB="["
	CB="]"

    ## Finally, the prompt.
    PROMPT='$SET_CHARSET$STITLE${(e)TITLEBAR}\
%F{14}$SHIFT_IN$ULCORNER%F{6}$HBAR$SHIFT_OUT\
$OB%F{4}%(!.%SROOT%s.%n)%F{15}@%F{4}%m%F{6}$CB\
$SHIFT_IN$HBAR%F{14}$HBAR${(e)FILLBAR}%F{6}$HBAR$SHIFT_OUT\
$OB%F{5}%$PWDLEN<...<%~%<<%F{6}$CB\
$SHIFT_IN$HBAR%F{14}$URCORNER$SHIFT_OUT\

%F{14}$SHIFT_IN$LLCORNER%F{6}$HBAR$SHIFT_OUT\
(%(?..%F{9}%?%F{6}:)${(e)APM}%F{5}%D{%H:%M}%F{6})\
$SHIFT_IN$HBAR%F{14}$HBAR$SHIFT_OUT %(!.%F{1}.%F{15})%#%f '

    RPROMPT='%F{14}$SHIFT_IN$HBAR%F{6}$HBAR$SHIFT_OUT\
($vcs_info_msg_0_%F{6})$SHIFT_IN$HBAR%F{14}$LRCORNER$SHIFT_OUT%f'

    PS2='%F{14}$SHIFT_IN$HBAR$SHIFT_OUT\
%F{6}$SHIFT_IN$HBAR$SHIFT_OUT\
(%F{4}%_%F{6})$SHIFT_IN$HBAR$SHIFT_OUT\
%F{14}$SHIFT_IN$HBAR$SHIFT_OUT%f '
}

setprompt

