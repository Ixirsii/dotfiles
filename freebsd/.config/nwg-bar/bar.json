[
    {
        "label": "Lock",
        "exec": "hyprlock",
        "icon": "/usr/local/share/nwg-bar/images/system-lock-screen.svg"
    },
    {
        "label": "Logout",
        "exec": "hyprshutdown",
        "icon": "/usr/local/share/nwg-bar/images/system-log-out.svg"
    },
    {
        "label": "Suspend",
        "exec": "systemctl suspend",
        "icon": "/usr/local/share/nwg-bar/images/system-suspend.svg"
    },
    {
        "label": "Hibernate",
        "exec": "systemctl hibernate",
        "icon": "/usr/local/share/nwg-bar/images/system-hibernate.svg"
    },
    {
        "label": "Reboot",
        "exec": "hyprshutdown --post-cmd 'systemctl reboot'",
        "icon": "/usr/local/share/nwg-bar/images/system-reboot.svg"
    },
    {
        "label": "Shutdown",
        "exec": "hyprshutdown --post-cmd 'systemctl -i poweroff'",
        "icon": "/usr/local/share/nwg-bar/images/system-shutdown.svg"
    }
]
