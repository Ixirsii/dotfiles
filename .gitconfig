[user]
    email = ixirsii@ixirsii.tech
    name = Ryan Porterfield
    signingKey = E08EE51047CC0C7B

[alias]
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order

[color]
    ui = auto

[commit]
    gpgSign = true

[core]
    autocrlf = input
    pager = delta

[delta]
    navigate = true
    side-by-side = true

[diff]
    colorMoved = default

[gpg]
    program = gpg

[http]
    sslVerify = true

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictstyle = diff3

[push]
    default = simple

[pull]
    rebase = true

[rerere]
    enabled = true

[tag]
    forceSignAnnotated = true
