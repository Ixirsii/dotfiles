# Accounts will inherit settings from this section
defaults
auth            on
tls             on
tls_starttls    on
logfile         /home/ryan/.msmtp.log
syslog          off

# Personal email
account         personal
host            mail.ryanporterfield.com
port            587
from            Ryan@RyanPorterfield.com
user            Ryan@RyanPorterfield.com
tls_certcheck   off

# School email
account         school
host            pod51000.outlook.com
port            587
from            RyanPorterfield@my.unt.edu
user            RyanPorterfield@my.unt.edu
tls_trust_file  /etc/ssl/certs/ca-certificates.crt

# Google account
account         gmail
host            smtp.gmail.com
port            587
from            RedRaider92@gmail.com
user            RedRaider92@gmail.com
tls_trust_file  /etc/ssl/certs/ca-certificates.crt

# Set a default account
account default : personal
