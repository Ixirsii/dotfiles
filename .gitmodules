[submodule "common/.config/zsh/zsh-autosuggestions"]
	path = common/zsh/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "common/.config/zsh/zsh-syntax-highlighting"]
	path = common/zsh/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting
[submodule "common/.config/zsh/zsh-you-should-use"]
	path = common/zsh/zsh-you-should-use
	url = https://github.com/MichaelAquilina/zsh-you-should-use
[submodule "common/.config/zsh/catppuccin/zsh-syntax-highlighting"]
	path = common/zsh/catppuccin/zsh-syntax-highlighting
	url = https://github.com/catppuccin/zsh-syntax-highlighting.git
[submodule "common/.config/zsh/fzf-git.sh"]
	path = common/zsh/fzf-git.sh
	url = https://github.com/junegunn/fzf-git.sh.git
[submodule "linux/.config/tmux/plugins/tpm"]
	path = common/tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm.git
