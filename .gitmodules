[submodule "common/.config/zsh/zsh-autosuggestions"]
	path = common/.config/zsh/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "common/.config/zsh/zsh-syntax-highlighting"]
	path = common/.config/zsh/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting
[submodule "common/.config/zsh/zsh-you-should-use"]
	path = common/.config/zsh/zsh-you-should-use
	url = https://github.com/MichaelAquilina/zsh-you-should-use
[submodule "common/.config/zsh/catppuccin/zsh-syntax-highlighting"]
	path = common/.config/zsh/catppuccin/zsh-syntax-highlighting
	url = https://github.com/catppuccin/zsh-syntax-highlighting.git
[submodule "common/.config/zsh/fzf-git.sh"]
	path = common/.config/zsh/fzf-git.sh
	url = https://github.com/junegunn/fzf-git.sh.git
[submodule "linux/.config/tmux/plugins/tpm"]
	path = linux/.config/tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm.git
[submodule "linux/.config/tmux/plugins/tmux-cpu"]
	path = linux/.config/tmux/plugins/tmux-cpu
	url = https://github.com/tmux-plugins/tmux-cpu.git
[submodule "linux/.config/tmux/plugins/tmux-sensible"]
	path = linux/.config/tmux/plugins/tmux-sensible
	url = https://github.com/tmux-plugins/tmux-sensible.git
[submodule "linux/.config/tmux/plugins/tmux-yank"]
	path = linux/.config/tmux/plugins/tmux-yank
	url = https://github.com/tmux-plugins/tmux-yank.git
[submodule "linux/.config/tmux/plugins/catppuccin"]
	path = linux/.config/tmux/plugins/catppuccin
	url = https://github.com/catppuccin/tmux.git
